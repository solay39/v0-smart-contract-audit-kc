{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["auditId", "name", "score", "status", "evidence"],
  "properties": {
    "auditId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "status": { "type": "string", "enum": ["VERIFIED", "PENDING", "REJECTED"] },
    "evidence": {
      "type": "object",
      "required": ["reportHash", "reviewerNames", "ciArtifacts", "commitHash"],
      "properties": {
        "reportHash": { "type": "string", "minLength": 1 },
        "reviewerNames": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "ciArtifacts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "commitHash": { "type": "string", "minLength": 1 },
        "attestationCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
